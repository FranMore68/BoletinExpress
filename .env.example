# Valores de ejemplo; secretos reales solo en .secrets o Coolify.
APP_ENV=evaluation
APP_URL=http://127.0.0.1:3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
AUTH_PROOF_SECRET=
# La aplicación usa la clave anon en servidor y el JWT del usuario para RLS.
# No necesita SERVICE_ROLE_KEY; no poner secretos en NEXT_PUBLIC_.
# Generación local reproducible: node scripts/init-local-auth.mjs

# Correo documental: configuración local en compose.auth.yaml (Mailpit).
# Para Resend, archivo excluido .secrets/mail.env solo en el worker:
# MAIL_TRANSPORT=resend
# MAIL_FROM=BoletinExpress <remitente@dominio-verificado>
# RESEND_API_KEY=
# Reloj documental: scripts/evaluation-clock.mjs; solo cuentas @example.invalid autorizadas.

# Pagos: node scripts/init-payment-key.mjs genera la credencial RPC restringida.
# Secretos Stripe solo en .secrets/stripe.env (web, nunca worker ni navegador):
# STRIPE_SECRET_KEY= (solo sk_test_ o rk_test_)
# STRIPE_WEBHOOK_SECRET= (whsec_ del endpoint o de Stripe CLI)
# Endpoint: POST /api/payments/stripe; API fijada en 2026-09-30.endive.
