# Valores de ejemplo; secretos reales solo en .secrets o Coolify.
APP_ENV=evaluation
APP_URL=http://127.0.0.1:3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
AUTH_PROOF_SECRET=
# La aplicación usa la clave anon en servidor y el JWT del usuario para RLS.
# No necesita SERVICE_ROLE_KEY; no poner secretos en NEXT_PUBLIC_.
# Generación local reproducible: node scripts/init-local-auth.mjs
